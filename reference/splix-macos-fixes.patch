+/*
+ * Make a job or user name safe inside a PJL quoted string: no quotes or
+ * control characters (which would end the string or the command), ASCII only,
+ * and at most 80 characters.
+ */
+static std::string _pjlString(const char *value)
+{
+    std::string out;
+    for (const char *p = value ? value : ""; *p && out.size() < 80; p++) {
+        unsigned char c = (unsigned char)*p;
+        if (c == '"')
+            out += '\'';
+        else if (c < 0x20 || c == 0x7f)
+            out += ' ';
+        else if (c > 0x7f)
+            out += '?';
+        else
+            out += (char)c;
+    }
+    return out;
+}
